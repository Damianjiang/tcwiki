# HTML 文档：浏览器缓存 5 分钟，部署后通过文件名 hash 的资源自动更新
# (VitePress 的 HTML 引用的 /assets/* 都带 hash, 内容变更会生成新文件, 故 HTML 短缓存安全)
/*.html
  Cache-Control: public, max-age=300

/
  Cache-Control: public, max-age=300

# 带 hash 的静态资源长缓存（VitePress 构建产物，文件名含 hash，内容变更会生成新文件）
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# 图片缓存 7 天
/*.png
  Cache-Control: public, max-age=604800
/*.jpg
  Cache-Control: public, max-age=604800
/*.jpeg
  Cache-Control: public, max-age=604800
/*.webp
  Cache-Control: public, max-age=604800
/*.svg
  Cache-Control: public, max-age=604800
/*.ico
  Cache-Control: public, max-age=604800

# 字体长缓存
/*.woff
  Cache-Control: public, max-age=31536000, immutable
/*.woff2
  Cache-Control: public, max-age=31536000, immutable
/*.ttf
  Cache-Control: public, max-age=31536000, immutable
